{
  "info": {
    "name": "Prueba - Pedidos - API Pedidos",
    "description": "Colección para probar la API de autenticación y CRUD de Pedidos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:7064/" },
    { "key": "token", "value": "" },
    { "key": "pedidoId", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('token', json.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@pedido.com\",\n  \"password\": \"Password123!\"\n}"
            }
          }
        },
        {
          "name": "Login - Credenciales inválidas (401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@pedido.com\",\n  \"password\": \"incorrecta\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Listar Pedidos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/pedidos"
          }
        },
        {
          "name": "Obtener Pedido por Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}"
          }
        },
        {
          "name": "Crear Pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('pedidoId', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroPedido\": \"PED-100\",\n  \"cliente\": \"Ana Torres\",\n  \"fecha\": \"2026-09-20\",\n  \"total\": 350.50,\n  \"estado\": \"Registrado\"\n}"
            }
          }
        },
        {
          "name": "Crear Pedido - Total inválido (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroPedido\": \"PED-101\",\n  \"cliente\": \"Ana Torres\",\n  \"fecha\": \"2026-09-20\",\n  \"total\": 0\n}"
            }
          }
        },
        {
          "name": "Actualizar Pedido",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"Ana Torres Vega\",\n  \"fecha\": \"2026-09-21\",\n  \"total\": 400.00,\n  \"estado\": \"En Proceso\"\n}"
            }
          }
        },
        {
          "name": "Eliminar Pedido",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}"
          }
        },
        {
          "name": "Listar Pedidos - Sin token (401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/pedidos"
          }
        }
      ]
    }
  ]
}
